# Acceso inicial y recuperación del administrador. Usa un valor largo y aleatorio.
ADMIN_SETUP_TOKEN=

# Publicación del CMS en GitHub (producción).
GITHUB_TOKEN=
GITHUB_REPO=ruimaax/ALARYFES
GITHUB_BRANCH=main

# En local se publica al disco por defecto. Pon 1 para probar GitHub expresamente.
CMS_LOCAL_GITHUB=

# Copia opcional de cada solicitud en Google Sheets.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Aviso opcional por email de cada solicitud nueva.
RESEND_API_KEY=
AVISO_EMAIL_PARA=
AVISO_EMAIL_DESDE=

# Deploy Hook de Cloudflare para recompilar sin crear un commit.
CLOUDFLARE_DEPLOY_HOOK=

# Panel /admin/analitica. El token solo necesita Account Analytics: Read.
# Activa antes Web Analytics en el proyecto de Pages.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SITE_HOST=alaryfes.com
# Opcional pero recomendado: evita sumar otros Workers de la misma cuenta.
CLOUDFLARE_WORKER_NAME=

# Analítica opcional; no se carga sin consentimiento.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
